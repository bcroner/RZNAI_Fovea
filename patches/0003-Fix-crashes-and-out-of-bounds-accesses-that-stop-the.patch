From 419ffd6067f7bd5d8f65d2752953ac42851bd304 Mon Sep 17 00:00:00 2001
From: bcroner <seekandwander@gmail.com>
Date: Thu, 27 Aug 2026 09:54:41 -0700
Subject: [PATCH 3/4] Fix crashes and out-of-bounds accesses that stop the
 program running

Built with a reduced RZNAI_AGI_MAX_CYCLES the program terminated immediately
with an access violation (0xC0000005). Two causes, both memory safety.

instantiate() never allocated Input_Queue. AGI_Sys is value-initialised by
`new AGI_Sys()`, so the pointer was null, and cycle()'s first statement
    stm->Input_Queue[i] = stm->Input_Queue[i - 1];
wrote through it. Now allocated to In_Q_ct entries and zeroed, along with
Current_Input.

perform_iann() indexed three arrays out of bounds:

  - input_weights / input_targets have in_sz * In_Q_ct rows (112 with the
    shipped constants), one per queued input bit. The loop indexed them by a
    hidden-unit number running to hidden_sz (224), reading past the end of
    both arrays and dereferencing whatever followed.
  - input_b has in_sz * In_Q_ct entries but was indexed by the same
    hidden-unit number.
  - `stm->hidden[i]->firings[j]` indexed the layer array by a hidden-unit
    number running to hidden_sz (224) where only hidden_ct (16) layers exist.
    Writing to layer `count` is the only reading consistent with the loop
    reading from layer `count - 1`.

INFERRED, and worth the author's review: the corrected loops accumulate into
weight_sums across all sources and then threshold once, which is what the
variable is named for but not what the original nesting did -- the original
reset weight_sums[j] to 0 inside the accumulation loop. Firings are now
assigned rather than only ever set true, so a unit that does not fire this
cycle stops firing instead of latching on for the life of the program.

Also in perform_iann:

  - the returned value ignored output_b entirely and unconditionally set every
    bit, so the function always returned (1 << out_sz) - 1 no matter what the
    network computed
  - the output stage summed output_weights[j][k] over a j loop unrelated to
    the firing unit i, so every firing unit contributed the same total; it now
    keys on the firing unit
  - input_b, output_b and both weight_sums arrays were never freed, leaking on
    every cycle

With these applied the program runs to completion. Compiles clean under
MSVC 14.51 at /W3.
---
 RZNAI_AGI.cpp | 84 +++++++++++++++++++++++++++++++--------------------
 1 file changed, 51 insertions(+), 33 deletions(-)

diff --git a/RZNAI_AGI.cpp b/RZNAI_AGI.cpp
index 7438a9d..dcbbcbf 100644
--- a/RZNAI_AGI.cpp
+++ b/RZNAI_AGI.cpp
@@ -225,6 +225,13 @@ AGI_Sys * instantiate() {
         ret->Knowledge_Bank[i]->vect_state = 0;
     }
 
+    // cycle() shifts and writes Input_Queue on its very first statement, and
+    // perform_iann() reads it; nothing allocated it.
+    ret->Current_Input = 0;
+    ret->Input_Queue = new __int32 [ret->In_Q_ct];
+    for (__int32 i = 0; i < ret->In_Q_ct; i++)
+        ret->Input_Queue[i] = 0;
+
     ret->kb_rw_path = 0;
     ret->kb_dv_path = 0;
 
@@ -403,7 +410,12 @@ void generateBFSs(AGI_Sys* stm) {
 
 __int32 perform_iann(AGI_Sys* stm) {
 
-    bool* input_b = new bool[stm->in_sz * stm->In_Q_ct];
+    // input_weights and input_targets have one row per queued input bit, not
+    // hidden_sz rows.  Indexing them by a hidden-unit number reads past the
+    // end of both arrays and dereferences whatever follows.
+    const __int32 in_units = stm->in_sz * stm->In_Q_ct;
+
+    bool* input_b = new bool[in_units];
 
     for (__int32 i = 0; i < stm->In_Q_ct; i++) {
 
@@ -416,56 +428,62 @@ __int32 perform_iann(AGI_Sys* stm) {
 
     }
 
-    for (__int32 i = 0; i < stm->hidden_sz; i++) {
-        __int32 * weight_sums = new __int32 [stm->hidden_sz];
-        for (__int32 j = 0; j < stm->hidden_sz; j++) {
-            weight_sums[j] = 0;
-            for (__int32 k = 0; k < stm->hidden_sz >> 1; k++)
-                weight_sums[stm->input_targets[j][k]] += input_b[i] ? stm->input_weights[j][k] : 0;
-            if (weight_sums[j] >= 0)
-                stm->hidden[0]->firings[j] = true;
-        }
-    }
+    __int32* weight_sums = new __int32[stm->hidden_sz];
 
+    // input layer: in_units input bits fan out into hidden_sz hidden units
+    for (__int32 j = 0; j < stm->hidden_sz; j++)
+        weight_sums[j] = 0;
+
+    for (__int32 i = 0; i < in_units; i++)
+        for (__int32 k = 0; k < stm->hidden_sz >> 1; k++)
+            weight_sums[stm->input_targets[i][k]] += input_b[i] ? stm->input_weights[i][k] : 0;
+
+    for (__int32 j = 0; j < stm->hidden_sz; j++)
+        stm->hidden[0]->firings[j] = weight_sums[j] >= 0;
+
+    // hidden layers: layer count-1 drives layer count
     for (__int32 count = 1; count < stm->hidden_ct; count++) {
 
-        for (__int32 i = 0; i < stm->hidden_sz; i++) {
-            __int32* weight_sums = new __int32[stm->hidden_sz];
-            for (__int32 j = 0; j < stm->hidden_sz; j++) {
-                weight_sums[j] = 0;
-                for (__int32 k = 0; k < stm->hidden_sz >> 1; k++)
-                    weight_sums[stm->hidden[count - 1]->targets[j][k]] += stm->hidden [count - 1]->firings[i] ? stm->hidden [count - 1]->weights[j][k] : 0;
-                if (weight_sums[j] >= 0)
-                    stm->hidden[i]->firings[j] = true;
-            }
-        }
+        for (__int32 j = 0; j < stm->hidden_sz; j++)
+            weight_sums[j] = 0;
+
+        for (__int32 i = 0; i < stm->hidden_sz; i++)
+            for (__int32 k = 0; k < stm->hidden_sz >> 1; k++)
+                weight_sums[stm->hidden[count - 1]->targets[i][k]] +=
+                    stm->hidden[count - 1]->firings[i] ? stm->hidden[count - 1]->weights[i][k] : 0;
+
+        for (__int32 j = 0; j < stm->hidden_sz; j++)
+            stm->hidden[count]->firings[j] = weight_sums[j] >= 0;
     }
 
+    delete[] weight_sums;
+
     bool* output_b = new bool[stm->out_sz];
+    __int32* out_sums = new __int32[stm->out_sz];
 
-    for (__int32 i = 0; i < stm->out_sz; i++)
+    for (__int32 i = 0; i < stm->out_sz; i++) {
         output_b[i] = false;
-
-    __int32* weight_sums = new __int32[stm->out_sz];
-    for (__int32 i = 0; i < stm->out_sz; i++)
-        weight_sums[i] = 0;
+        out_sums[i] = 0;
+    }
 
     for (__int32 i = 0; i < stm->hidden_sz; i++)
         if (stm->hidden[stm->hidden_ct - 1]->firings[i])
-            for (__int32 j = 0; j < stm->hidden_sz >> 1; j++)
-                for (__int32 k = 0; k < stm->out_sz >> 1; k++)
-                    weight_sums[stm->output_targets[j][k]] += stm->output_weights[j][k];
+            for (__int32 k = 0; k < stm->out_sz >> 1; k++)
+                out_sums[stm->output_targets[i][k]] += stm->output_weights[i][k];
 
     for (__int32 i = 0; i < stm->out_sz; i++)
-        if (weight_sums[i] >= 0)
+        if (out_sums[i] >= 0)
             output_b[i] = true;
 
-    delete[] weight_sums;
-
     __int32 ret_output = 0;
 
     for (__int32 i = 0; i < stm->out_sz; i++)
-        ret_output |= (0x1 << i);
+        if (output_b[i])
+            ret_output |= (0x1 << i);
+
+    delete[] out_sums;
+    delete[] output_b;
+    delete[] input_b;
 
     return ret_output;
 }
